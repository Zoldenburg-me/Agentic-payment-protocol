{
  "name": "@zold/accept",
  "version": "0.0.0",
  "private": true,
  "description": "Accept x402 payments in any Node HTTP server: verify, claim, settle on-chain, deliver once. No facilitator.",
  "type": "module",
  "exports": {
    ".": {
      "agentpay-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "agentpay-source": "./src/sqlite/index.ts",
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "agentpay-hub": "file:../..",
    "viem": "^2.57.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm --prefix ../.. run build"
  },
  "files": [
    "dist"
  ]
}
