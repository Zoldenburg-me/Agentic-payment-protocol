{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "customConditions": [
      "agentpay-source"
    ]
  },
  "include": [
    "src",
    "test",
    "examples",
    "packages/*/src",
    "packages/*/test"
  ]
}
