{
  "name": "agentpay-hub",
  "version": "0.1.0",
  "description": "One interface for agent payment protocols (x402, MPP, ...). Detects what a payee speaks, enforces spend policy, pays.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentpay-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p packages/accept/tsconfig.build.json && tsc -p packages/hosted/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=agentpay-source --import tsx --test --test-timeout=20000 \"test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "hub": "node --conditions=agentpay-source --import tsx packages/hosted/src/main.ts",
    "hub:merchant": "node --conditions=agentpay-source --import tsx packages/hosted/src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "demo": "tsx examples/demo.ts",
    "pay": "tsx examples/pay-url.ts",
    "coverage": "c8 --check-coverage --lines 80 --branches 80 --functions 80 --include \"src/**\" --include \"packages/*/src/**\" --exclude \"src/mcp/server.ts\" --exclude \"packages/hosted/src/main.ts\" --exclude \"packages/hosted/src/cli.ts\" --reporter text-summary --reporter text node --conditions=agentpay-source --import tsx --test --test-timeout=20000 \"test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\"",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.57.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "c8": "^10.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "agentpay-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "agentpay-source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md"
  ]
}
